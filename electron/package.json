{
  "name": "NexusTok-electron",
  "version": "1.0.0",
  "description": "NexusTok - AI Model Gateway Desktop Application",
  "main": "main.js",
  "scripts": {
    "start-app": "electron .",
    "dev-app": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "ai",
    "api",
    "gateway",
    "openai",
    "claude"
  ],
  "author": "c1cadaBob",
  "repository": {
    "type": "git",
    "url": "https://github.com/c1cadaBob/NexusTok"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  },
  "build": {
    "appId": "com.nexustok.desktop",
    "productName": "NexusTok-App",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "tray-iconTemplate.png",
      "tray-iconTemplate@2x.png",
      "tray-icon-windows.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../NexusTok",
          "to": "bin/NexusTok"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/LICENSE"
        },
        {
          "from": "../NOTICE",
          "to": "licenses/NOTICE"
        },
        {
          "from": "../THIRD-PARTY-LICENSES.md",
          "to": "licenses/THIRD-PARTY-LICENSES.md"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "licenses/electron/LICENSE"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "licenses/electron/LICENSES.chromium.html"
        }
      ]
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "../NexusTok.exe",
          "to": "bin/NexusTok.exe"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/LICENSE"
        },
        {
          "from": "../NOTICE",
          "to": "licenses/NOTICE"
        },
        {
          "from": "../THIRD-PARTY-LICENSES.md",
          "to": "licenses/THIRD-PARTY-LICENSES.md"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "licenses/electron/LICENSE"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "licenses/electron/LICENSES.chromium.html"
        }
      ]
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "extraResources": [
        {
          "from": "../NexusTok",
          "to": "bin/NexusTok"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/LICENSE"
        },
        {
          "from": "../NOTICE",
          "to": "licenses/NOTICE"
        },
        {
          "from": "../THIRD-PARTY-LICENSES.md",
          "to": "licenses/THIRD-PARTY-LICENSES.md"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "licenses/electron/LICENSE"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "licenses/electron/LICENSES.chromium.html"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
