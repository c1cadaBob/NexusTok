# Dockerfile.account-pool-sidecar - 账号池 Sidecar 容器
#
# 功能：
# - 构建 CLIProxyAPI 账号池代理服务
# - 提供账号池管理和 OAuth 认证功能
# - 作为 NexusTok 的 Sidecar 容器运行
#
# 构建参数：
#   VERSION - 版本号（默认: dev）
#   COMMIT - 提交哈希（默认: none）
#   BUILD_DATE - 构建日期（默认: unknown）
#
# 暴露端口：8317

# 构建阶段
FROM golang:1.26.1-alpine AS builder

WORKDIR /build
COPY modules/cliproxyapi/go.mod modules/cliproxyapi/go.sum ./
RUN go mod download

COPY modules/cliproxyapi .

ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_DATE=unknown

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -X 'main.Version=${VERSION}' -X 'main.Commit=${COMMIT}' -X 'main.BuildDate=${BUILD_DATE}'" -o /out/CLIProxyAPI ./cmd/server/

FROM alpine:3.23

RUN apk add --no-cache ca-certificates tzdata \
    && mkdir -p /opt/cliproxyapi /data/account-pool/cliproxyapi

COPY --from=builder /out/CLIProxyAPI /usr/local/bin/CLIProxyAPI
COPY modules/cliproxyapi/config.example.yaml /opt/cliproxyapi/config.example.yaml
COPY bin/docker-account-pool-sidecar.sh /usr/local/bin/docker-account-pool-sidecar.sh

WORKDIR /opt/cliproxyapi
EXPOSE 8317
ENTRYPOINT ["/usr/local/bin/docker-account-pool-sidecar.sh"]
